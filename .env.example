# Copy this file to .env and fill in values for local development.
# Never commit .env — it is gitignored.

# Port the MCP server listens on (Render injects this automatically)
PORT=8000

# API key for MCP server authentication (recommended for production)
# Set this to protect your server from unauthorized access
# Clients must include this in the X-API-Key header
MCP_API_KEY=your-secret-api-key-here

# LLM backend for graphify (optional, opt-in only)
# Set GRAPHIFY_USE_LLM=true to enable LLM-based semantic extraction
# Default is false (basic graph generation without LLM)
GRAPHIFY_USE_LLM=false

# LLM backend configuration (only used if GRAPHIFY_USE_LLM=true)
# GRAPHIFY_BACKEND=ollama
# GRAPHIFY_MODEL=llama3:latest

# Optional: LLM API keys for cloud backends (only used if GRAPHIFY_USE_LLM=true)
# Only one key is required if you prefer cloud backends. graphify auto-detects which backend to use.
# Priority: Gemini → Kimi → Claude → OpenAI → DeepSeek → Bedrock → Ollama
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...     # alternative — has a free tier
# OPENAI_API_KEY=sk-...
