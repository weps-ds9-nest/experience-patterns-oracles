# Copy this file to .env and fill in values for local development.
# Never commit .env — it is gitignored.

# Port the MCP server listens on (Render injects this automatically)
PORT=8000

# API key for MCP server authentication (recommended for production)
# Set this to protect your server from unauthorized access
# Clients must include this in the X-API-Key header
MCP_API_KEY=your-secret-api-key-here

# LLM API key used by graphify to semantically extract wiki/ on first run.
# OPTIONAL - the server will use Ollama backend if available, or fall back to basic graph generator.
# Only one key is required if you prefer cloud backends. graphify auto-detects which backend to use.
# Priority: Gemini → Kimi → Claude → OpenAI → DeepSeek → Bedrock → Ollama
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...     # alternative — has a free tier
# OPENAI_API_KEY=sk-...

# Ollama backend configuration (optional, no API key needed)
# OLLAMA_HOST=http://localhost:11434
